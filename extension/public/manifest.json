{
  "manifest_version": 3,
  "name": "Naviseerr for YouTube Music",
  "description": "See what your Naviseerr server is downloading, and everything it has downloaded.",
  "version": "0.1.0",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Naviseerr downloads"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
