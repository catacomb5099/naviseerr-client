# A reverse proxy in front of the web app (TrueNAS, Nginx Proxy Manager, another Caddy doing HTTPS) sits
# on your network or Docker network: trust its X-Forwarded-* headers, so naviseerr learns the request came
# over HTTPS, marks the login cookie Secure and shows an https:// Redirect URL for Authentik. Without this
# Caddy overwrites them with its own plain-HTTP view.
{
	servers {
		trusted_proxies static private_ranges
	}
}

# Plain HTTP inside the container (no hostname, so Caddy does not try to set up HTTPS);
# compose maps it to a port on your machine.
:80 {
	encode

	# The server: /api/search/x reaches naviseerr as /search/x. Caddy keeps encoded characters
	# such as %2F (AC/DC) intact, which nginx's usual prefix strip does not. naviseerr is looked
	# up on every request, so the web app starts even while the server is still down.
	handle_path /api/* {
		# The server sees /auth/... without the /api stripped here; this header tells it the public
		# path, so the Redirect URL it shows for Authentik (Settings -> Login) is the one browsers reach.
		reverse_proxy naviseerr:8080 {
			header_up X-Forwarded-Prefix /api
		}
	}

	root * /srv

	# Vite's built files get a new name every build, so browsers can keep them for good.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The app itself: real files as they are, any other path gets index.html so /downloads,
	# /album/<id>, ... survive a reload. no-cache so a new version shows up at once.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
